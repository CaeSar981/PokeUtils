    <artifactId>pokeutils-stub-api</artifactId>
    <packaging>jar</packaging>

    <name>PokeUtils :: Stub API</name>
    <description>
        仅用于编译的第三方 API 桩（Pixelmon / PokeStar / PokemonAPI / MSGToggle / Blank038API / NMS / Vault）。
        这些类不会被打进 PokeUtils 插件，运行期由服务端上的真实插件与模组提供。
        若本地已有真实插件 jar，可用 README 中的 profile 替换本模块。
    </description>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.12.2-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
